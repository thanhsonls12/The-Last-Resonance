config_version=5

[application]

config/name="The Last Resonance"
run/main_scene="res://scenes/ui/start_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/the_last_resonance_icon.png"

[autoload]

